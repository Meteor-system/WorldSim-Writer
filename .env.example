# Docker Compose release-stack settings. Copy this file to .env and replace every placeholder before starting containers.
COMPOSE_PROJECT_NAME=worldsim-writer-beta
COMPOSE_API_BIND_ADDRESS=127.0.0.1
COMPOSE_API_PORT=8000
WORLDSIM_IMAGE_TAG=local

POSTGRES_DB=worldsim_writer
POSTGRES_USER=worldsim
# Use a long URL-safe value because Compose inserts it into DATABASE_URL.
POSTGRES_PASSWORD=change-this-database-password

# The backend rejects this exact example value. Replace it with a long random value.
SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MOCK=true

FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_SECONDS=5
DB_APPLICATION_NAME=worldsim-writer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800

API_WORKERS=1
API_BACKLOG=2048
API_LIMIT_CONCURRENCY=100
API_TIMEOUT_KEEP_ALIVE_SECONDS=5
API_TIMEOUT_GRACEFUL_SHUTDOWN_SECONDS=30
API_STOP_GRACE_PERIOD=40s
API_PROXY_HEADERS=false
API_FORWARDED_ALLOW_IPS=127.0.0.1
