DATABASE_URL=postgresql+psycopg://worldsim:worldsim@localhost:5432/worldsim_writer
SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MOCK=false
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated allowed origins; takes precedence over FRONTEND_ORIGIN when set.
# Leave empty to use FRONTEND_ORIGIN. Common local dev origins
# (localhost/127.0.0.1 on 5173 and 3000) are always allowed regardless.
FRONTEND_ORIGINS=
